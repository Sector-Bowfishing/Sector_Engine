{
  "rule": [
    {
      "action": {"type": "Delete"},
      "condition": {"age": 30, "matchesPrefix": ["baselines-archive/"]}
    },
    {
      "action": {"type": "Delete"},
      "condition": {"isLive": false, "daysSinceNoncurrentTime": 7, "matchesPrefix": ["baselines/", "baselines-archive/"]}
    }
  ]
}
