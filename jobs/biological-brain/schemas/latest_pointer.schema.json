{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Biological Brain bundle pointer (biology/v1/latest.json)",
 "type": "object",
 "required": [
  "schemaVersion",
  "brainId",
  "researchVersion",
  "manifest",
  "manifestSha256"
 ],
 "properties": {
  "schemaVersion": {
   "const": 1
  },
  "brainId": {
   "const": "biological-state"
  },
  "researchVersion": {
   "type": "string"
  },
  "manifest": {
   "type": "string",
   "description": "path relative to biology/v1"
  },
  "manifestSha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "publishedAt": {
   "type": "string"
  }
 }
}