{
  "schemaVersion": "1.0.0",
  "brainId": "water-clarity",
  "displayName": "Water Clarity Brain",
  "humanName": "Water Clarity",
  "domain": "condition",
  "lifecycle": "CALIBRATION",
  "contractVersion": "1.0.0",
  "runtime": {
    "kind": "job",
    "language": "python",
    "entrypoint": "brains/water-clarity/runtime/run.py",
    "trigger": {"kind": "manual"}
  },
  "publishes": [
    {
      "contractId": "clarity-publication-v1",
      "version": "1.0.0",
      "schemaRef": "brains/water-clarity/contracts/clarity-publication-v1.json",
      "pathFamilies": [
        "/lakes/{k}/states/waterClarity", "/lakes/{k}/profiles/waterClarity",
        "/lakeFleet/{k}/slots/waterClarity", "/lakeFleet/{k}/slots/waterClarity/{child}",
        "/lakeFleet/{k}/readiness/waterClarity", "/lakeFleet/{k}/modelVersions/waterClarity",
        "/brains/water-clarity/{child}", "/validation/water-clarity", "/health/brains/water-clarity/{child}", "/activity/{event}",
        "/sources/{id}", "/health/sources/{id}"
      ],
      "legacyDirectWrites": [
        {"path": "/snapshots/{k}/latest/waterClarity", "disposition": "PUBLISHER_COMPATIBILITY_PROJECTION", "ref": "clarity-snapshot-copy-v1"},
        {"path": "/snapshots/{k}/latest/brainVersions/water-clarity", "disposition": "PUBLISHER_COMPATIBILITY_PROJECTION", "ref": "clarity-snapshot-brainversion-v1"},
        {"path": "/snapshots/{k}/latest/lakeId", "disposition": "PLATFORM_OWNED_STOP_WRITING", "ref": "snapshot-lakeid"},
        {"path": "/lakeFleet/{k}/lakeId", "disposition": "PLATFORM_OWNED_STOP_WRITING", "ref": "lakefleet-lakeid"},
        {"path": "/health/jobs/{job}", "disposition": "ORCHESTRATOR_DERIVED", "ref": "health-jobs"}
      ]
    }
  ],
  "consumes": [
    {"kind": "registry", "registry": "lakes", "contractId": "registry.lakes", "minVersion": "1.0.0", "requirement": "REQUIRED"}
  ],
  "providers": [],
  "researchWorkspace": {"workspaceId": "water-clarity"},
  "score": {"type": "ENGINE_READINESS_SCORE", "path": "/scores/water-clarity", "rubricRef": "docs/brains/scoring/frozen-scores.json"},
  "customerIntegrationMode": "none",
  "publisherRequired": {"required": true, "cutoverStatus": "SHADOW"},
  "authorizedConsumers": ["ops", "sector-intelligence"],
  "tests": ["brains/water-clarity/tests"],
  "dataBudget": {"maxTrackedFileBytes": 1048576, "exceptions": []},
  "knowledge": {
    "stores": [
      {
        "id": "clarity-catalog",
        "store": "PACKAGED_IN_IMAGE",
        "owner": "water-clarity",
        "location": "brains/water-clarity/runtime/knowledge-release.json",
        "loader": "brains/water-clarity/runtime/clarity_brain.py verified_release",
        "verification": "sector_brain_platform.knowledge_release: per-file sha256 and bytes plus release digest",
        "lineage": "knowledgeRelease, manifestRef and manifestSha256 in the shadow artifact lineage",
        "approval": "NOT_RECORDED",
        "onUnavailable": "REFUSE"
      }
    ],
    "researchFallback": false,
    "tests": [
      "brains/water-clarity/tests/test_knowledge_memory.py",
      "jobs/brain_platform/tests/test_knowledge_release.py"
    ],
    "notes": "The optional private catalog overlay is detail only, is not digest-verified, and degrades explicitly (PRIVATE_OVERLAY_UNAVAILABLE). Lake outlines (polygons.geojson.gz) are Lake Surface data copied into the image."
  },
  "operations": {
    "executionModes": [
      "INTERNAL"
    ],
    "knowledgeLoading": {
      "approved": "NONE",
      "experimental": "clarity-catalog (PACKAGED_IN_IMAGE, brains/water-clarity/runtime/knowledge-release.json, approval NOT_RECORDED)",
      "refuseWithoutApproved": [
        "CUSTOMER_SERVING"
      ]
    },
    "internalPublication": [
      "fam.activity",
      "fam.brains",
      "fam.health-brains",
      "fam.health-sources",
      "fam.lake-profiles",
      "fam.lake-states",
      "fam.lakefleet",
      "fam.sources",
      "fam.validation"
    ],
    "internalExecution": "water-clarity-brain Cloud Run job (C1) started by brain-orchestrator when 26 h stale, 2 pilot lakes; the satellite pipeline stays PAUSED",
    "execution": {"authority": "brain-orchestrator", "trigger": "TIME", "minIntervalHours": 26.0, "refresh": "C1 pilot publisher; due when 26 h old (satellite pipeline paused)", "dependsOn": [], "independentSchedule": false, "controlledBy": "fam.control-execution-control (global + per-Brain; fail closed; read by the orchestrator only)"},
    "customerPublication": {
      "status": "NOT_ELIGIBLE",
      "approvalRef": null
    },
    "notes": "No APPROVED knowledge release exists (approval NOT_RECORDED): production runs are INTERNAL mode on the packaged candidate/reviewed knowledge. Outputs stay in INTERNAL-lane families; customerPublication false (PRE_PRODUCTION)."
  }
}
