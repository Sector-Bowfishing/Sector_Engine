{
  "schemaVersion": "1.0.0",
  "brainId": "depth",
  "displayName": "Depth Brain",
  "humanName": "Depth",
  "domain": "effective-depth",
  "lifecycle": "PROFILED",
  "contractVersion": "0.1.0",
  "runtime": {
    "kind": "in-process",
    "language": "python",
    "entrypoint": "brains/depth/runtime/run.py",
    "trigger": {
      "kind": "manual"
    }
  },
  "publishes": [
    {
      "contractId": "depth-publication-v1",
      "version": "1.0.0",
      "schemaRef": "brains/depth/contracts/depth-publication-v1.json",
      "pathFamilies": [
        "/lakes/{k}/states/depth",
        "/lakeFleet/{k}/slots/depth",
        "/lakeFleet/{k}/readiness/depth",
        "/lakeFleet/{k}/modelVersions/depth",
        "/snapshots/{k}/latest/depth",
        "/snapshots/{k}/latest/brainVersions/depth",
        "/brains/depth/{child}",
        "/validation/depth",
        "/health/brains/depth/{child}",
        "/activity/{event}"
      ],
      "legacyDirectWrites": [
        {"path": "/snapshots/{k}/latest/lakeId", "disposition": "PLATFORM_OWNED_STOP_WRITING", "ref": "snapshot-lakeid"},
        {"path": "/lakeFleet/{k}/lakeId", "disposition": "PLATFORM_OWNED_STOP_WRITING", "ref": "lakefleet-lakeid"}
      ]
    }
  ],
  "consumes": [
    {
      "kind": "brain",
      "brainId": "lake-brain",
      "contractId": "lake-publication-v1",
      "minVersion": "1.0.0",
      "requirement": "REQUIRED"
    },
    {
      "kind": "registry",
      "registry": "lakes",
      "contractId": "registry.lakes",
      "minVersion": "1.0.0",
      "requirement": "REQUIRED"
    }
  ],
  "providers": [],
  "researchWorkspace": {
    "workspaceId": "depth"
  },
  "customerIntegrationMode": "none",
  "publisherRequired": {
    "required": true,
    "cutoverStatus": "SHADOW"
  },
  "authorizedConsumers": [
    "ops",
    "sector-intelligence"
  ],
  "tests": [
    "brains/depth/tests",
    "brains/depth/research/tools/tests"
  ],
  "dataBudget": {
    "maxTrackedFileBytes": 1048576,
    "exceptions": []
  },
  "knowledge": {
    "stores": [
      {
        "id": "depth-knowledge",
        "store": "PACKAGED_IN_IMAGE",
        "owner": "depth",
        "location": "brains/depth/runtime/knowledge/knowledge-release.json",
        "loader": "brains/depth/runtime/depth_brain/knowledge.py load",
        "verification": "sector_brain_platform.knowledge_release: per-file sha256 and bytes plus release digest",
        "lineage": "knowledgeRelease in the registry and run summary; knowledgeRelease, manifestRef and manifestSha256 in the SHADOW artifact lineage",
        "approval": "NOT_RECORDED",
        "onUnavailable": "REFUSE"
      }
    ],
    "researchFallback": false,
    "tests": [
      "brains/depth/tests/test_run_entry.py",
      "brains/depth/tests/test_knowledge_memory.py",
      "jobs/brain_platform/tests/test_knowledge_release.py"
    ],
    "notes": "CANDIDATE release (approval NOT_RECORDED): verified on load, never published from. --write and --plan report BLOCKED_AWAITING_APPROVED_RELEASE until a scientifically approved release (gated G-1) replaces it. Research datasets are not in the release or the repository."
  },
  "operations": {
    "executionModes": [
      "INTERNAL",
      "APPROVED_SCIENCE"
    ],
    "knowledgeLoading": {
      "approved": "NONE",
      "experimental": "depth-knowledge (PACKAGED_IN_IMAGE, brains/depth/runtime/knowledge/knowledge-release.json, approval NOT_RECORDED)",
      "refuseWithoutApproved": [
        "APPROVED_SCIENCE",
        "CUSTOMER_SERVING"
      ]
    },
    "internalPublication": [
      "fam.control-shadow-lane"
    ],
    "internalExecution": "SHADOW lane in brain-orchestrator (--run-shadow-lane, 24 h): candidate release, in-memory output, summary only; run.py --write keeps refusing (APPROVED_SCIENCE)",
    "customerPublication": {
      "status": "NOT_ELIGIBLE",
      "approvalRef": null
    },
    "notes": "INTERNAL mode publishes only the brain-shadow-lane-v1 summary at /control/shadowLaneV1/depth (lane INTERNAL_EXPERIMENTAL). The Brain-owned families fam.activity, fam.brains, fam.health-brains, fam.lake-states, fam.lakefleet, fam.snapshots, fam.validation are written only by the APPROVED_SCIENCE path, which refuses until an APPROVED release (G-1). fam.control-shadow-lane is not yet in the Cortex registry (CG-2.5-1)."
  }
}
