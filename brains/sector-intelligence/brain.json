{
  "schemaVersion": "1.0.0",
  "brainId": "sector-intelligence",
  "displayName": "Sector Intelligence",
  "humanName": "Sector Intelligence",
  "domain": "synthesis",
  "lifecycle": "CALIBRATION",
  "contractVersion": "1.0.0",
  "runtime": {
    "kind": "in-process",
    "language": "python",
    "entrypoint": "brains/sector-intelligence/runtime/run.py",
    "trigger": {"kind": "dependency"}
  },
  "publishes": [
    {
      "contractId": "sector-intelligence-publication-v1",
      "version": "1.0.0",
      "schemaRef": "brains/sector-intelligence/contracts/sector-intelligence-publication-v1.json",
      "pathFamilies": [
        "/lakes/{k}/states/intelligence", "/lakeFleet/{k}/slots/intelligence", "/lakeFleet/{k}/readiness/intelligence", "/lakeFleet/{k}/modelVersions/intelligence",
        "/snapshots/{k}/latest/sectorIntelligence", "/snapshots/{k}/latest/brainVersions/sector-intelligence",
        "/brains/sector-intelligence/{child}", "/validation/sector-intelligence", "/health/brains/sector-intelligence/{child}", "/activity/{event}"
      ],
      "legacyDirectWrites": [
        {"path": "/snapshots/{k}/latest/lakeId", "disposition": "PLATFORM_OWNED_STOP_WRITING", "ref": "snapshot-lakeid"},
        {"path": "/lakeFleet/{k}/lakeId", "disposition": "PLATFORM_OWNED_STOP_WRITING", "ref": "lakefleet-lakeid"}
      ]
    }
  ],
  "consumes": [
    {"kind": "brain", "brainId": "lake-brain", "contractId": "lake-publication-v1", "minVersion": "1.0.0", "requirement": "OPTIONAL"},
    {"kind": "brain", "brainId": "water-temp", "contractId": "water-temp-publication-v1", "minVersion": "1.0.0", "requirement": "OPTIONAL"},
    {"kind": "brain", "brainId": "water-clarity", "contractId": "clarity-publication-v1", "minVersion": "1.0.0", "requirement": "OPTIONAL"},
    {"kind": "brain", "brainId": "wind", "contractId": "wind-publication-v1", "minVersion": "1.0.0", "requirement": "OPTIONAL"},
    {"kind": "brain", "brainId": "biological-state", "contractId": "fish-publication-v1", "minVersion": "1.0.0", "requirement": "OPTIONAL"},
    {"kind": "registry", "registry": "lakes", "contractId": "registry.lakes", "minVersion": "1.0.0", "requirement": "REQUIRED"}
  ],
  "providers": [],
  "researchWorkspace": {"workspaceId": "sector-intelligence"},
  "score": {"type": "ENGINE_READINESS_SCORE", "path": "/scores/sector-intelligence", "rubricRef": "docs/brains/scoring/sector-intelligence-score-v1.json"},
  "customerIntegrationMode": "none",
  "publisherRequired": {"required": true, "cutoverStatus": "SHADOW"},
  "authorizedConsumers": ["ops"],
  "tests": ["brains/sector-intelligence/tests"],
  "dataBudget": {"maxTrackedFileBytes": 1048576, "exceptions": []},
  "knowledge": {
    "stores": [
      {
        "id": "intelligence-catalog",
        "store": "PACKAGED_IN_IMAGE",
        "owner": "sector-intelligence",
        "location": "brains/sector-intelligence/runtime/knowledge-release.json",
        "loader": "brains/sector-intelligence/runtime/run.py load_knowledge",
        "verification": "sector_brain_platform.knowledge_release: per-file sha256 and bytes plus release digest",
        "lineage": "knowledgeRelease, manifestRef and manifestSha256 in the shadow artifact lineage; release id and digest in the run summary",
        "approval": "NOT_RECORDED",
        "onUnavailable": "REFUSE"
      }
    ],
    "researchFallback": false,
    "tests": [
      "brains/sector-intelligence/tests/test_knowledge_memory.py",
      "jobs/brain_platform/tests/test_knowledge_release.py"
    ]
  },
  "operations": {
    "executionModes": [
      "INTERNAL"
    ],
    "knowledgeLoading": {
      "approved": "NONE",
      "experimental": "intelligence-catalog (PACKAGED_IN_IMAGE, brains/sector-intelligence/runtime/knowledge-release.json, approval NOT_RECORDED)",
      "refuseWithoutApproved": [
        "CUSTOMER_SERVING"
      ]
    },
    "internalPublication": [
      "fam.activity",
      "fam.brains",
      "fam.health-brains",
      "fam.lake-states",
      "fam.lakefleet",
      "fam.snapshots",
      "fam.validation"
    ],
    "internalExecution": "in-process in brain-orchestrator, dependency-driven, pilot lakes (input assembly only; no recommendation)",
    "customerPublication": {
      "status": "NOT_ELIGIBLE",
      "approvalRef": null
    },
    "notes": "No APPROVED knowledge release exists (approval NOT_RECORDED): production runs are INTERNAL mode on the packaged candidate/reviewed knowledge. Outputs stay in INTERNAL-lane families; customerPublication false (PRE_PRODUCTION)."
  }
}
