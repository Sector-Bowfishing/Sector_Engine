{
  "schemaVersion": "1.0.0",
  "brainId": "wind",
  "displayName": "Wind Brain",
  "humanName": "Wind",
  "domain": "condition",
  "lifecycle": "CALIBRATION",
  "contractVersion": "1.0.0",
  "runtime": {
    "kind": "job",
    "language": "python",
    "entrypoint": "brains/wind/runtime/main.py",
    "trigger": {"kind": "schedule", "staleHours": 1.5}
  },
  "publishes": [
    {
      "contractId": "wind-publication-v1",
      "version": "1.0.0",
      "schemaRef": "brains/wind/contracts/wind-publication-v1.json",
      "pathFamilies": [
        "/lakes/{k}/states/wind", "/lakes/{k}/profiles/wind", "/lakes/{k}/validation/wind",
        "/lakeFleet/{k}/slots/wind", "/lakeFleet/{k}/readiness/wind", "/lakeFleet/{k}/modelVersions/wind",
        "/brains/wind/{child}", "/validation/wind", "/health/brains/wind/{child}", "/activity/{event}",
        "/sources/{id}", "/health/sources/{id}"
      ],
      "legacyDirectWrites": [
        {"path": "/snapshots/{k}/latest/wind", "disposition": "PUBLISHER_COMPATIBILITY_PROJECTION", "ref": "wind-snapshot-copy-v1"},
        {"path": "/snapshots/{k}/latest/brainVersions/wind", "disposition": "PUBLISHER_COMPATIBILITY_PROJECTION", "ref": "wind-snapshot-brainversion-v1"},
        {"path": "/snapshots/{k}/latest/lakeId", "disposition": "PLATFORM_OWNED_STOP_WRITING", "ref": "snapshot-lakeid"},
        {"path": "/lakeFleet/{k}/lakeId", "disposition": "PLATFORM_OWNED_STOP_WRITING", "ref": "lakefleet-lakeid"},
        {"path": "/health/jobs/{job}", "disposition": "ORCHESTRATOR_DERIVED", "ref": "health-jobs-wind-hourly"}
      ]
    }
  ],
  "consumes": [
    {"kind": "registry", "registry": "lakes", "contractId": "registry.lakes", "minVersion": "1.0.0", "requirement": "REQUIRED"}
  ],
  "providers": [
    {"providerId": "noaa-nbm-v5", "domainInterpreter": true},
    {"providerId": "noaa-rtma-ru", "domainInterpreter": true},
    {"providerId": "iem-metar-wind", "domainInterpreter": true}
  ],
  "researchWorkspace": {"workspaceId": "wind-brain"},
  "score": {"type": "ENGINE_READINESS_SCORE", "path": "/scores/wind"},
  "customerIntegrationMode": "none",
  "publisherRequired": {"required": true, "cutoverStatus": "SHADOW"},
  "authorizedConsumers": ["ops", "sector-intelligence", "biological-state"],
  "tests": ["brains/wind/tests", "brains/wind/research/tools/tests"],
  "dataBudget": {"maxTrackedFileBytes": 1048576, "exceptions": []},
  "knowledge": {
    "stores": [
      {
        "id": "wind-knowledge",
        "store": "PACKAGED_IN_IMAGE",
        "owner": "wind",
        "location": "brains/wind/runtime/knowledge-release.json",
        "loader": "brains/wind/runtime/sector_wind/ingest.py verified_release",
        "verification": "sector_brain_platform.knowledge_release: per-file sha256 and bytes plus release digest",
        "lineage": "knowledgeRelease, manifestRef and manifestSha256 in the shadow artifact lineage",
        "approval": "NOT_RECORDED",
        "onUnavailable": "REFUSE"
      }
    ],
    "researchFallback": false,
    "tests": [
      "brains/wind/tests/test_knowledge_memory.py",
      "jobs/brain_platform/tests/test_knowledge_release.py"
    ],
    "notes": "The GCS forecast/observation archive is operational state, not knowledge."
  }
}
