{
  "schemaVersion": "1.0.0",
  "brainId": "biological-state",
  "displayName": "Fish Brain",
  "humanName": "Fish",
  "domain": "biology",
  "lifecycle": "PROFILED",
  "contractVersion": "1.0.0",
  "runtime": {
    "kind": "in-process",
    "language": "python",
    "entrypoint": "brains/fish/runtime/run.py",
    "trigger": {"kind": "dependency"}
  },
  "publishes": [
    {
      "contractId": "fish-publication-v1",
      "version": "1.0.0",
      "schemaRef": "brains/fish/contracts/fish-publication-v1.json",
      "pathFamilies": [
        "/species/{id}",
        "/brains/biological-state/{child}",
        "/validation/biological-state",
        "/health/brains/biological-state/{child}",
        "/activity/{event}"
      ]
    }
  ],
  "consumes": [],
  "providers": [],
  "researchWorkspace": {"workspaceId": "fish-brain"},
  "score": {"type": "ENGINE_READINESS_SCORE", "path": "/scores/biological-state", "rubricRef": "docs/brains/scoring/biological-state-score-v1.json"},
  "customerIntegrationMode": "none",
  "publisherRequired": {"required": true, "cutoverStatus": "SHADOW"},
  "authorizedConsumers": ["ops", "sector-intelligence"],
  "tests": ["brains/fish/tests"],
  "dataBudget": {"maxTrackedFileBytes": 1048576, "exceptions": []},
  "knowledge": {
    "stores": [
      {
        "id": "biology-bundle",
        "store": "PRIVATE_BUCKET_RELEASE",
        "owner": "biological-state",
        "location": "gs://sector-biology-private/biology/v1 (latest.json)",
        "loader": "brains/fish/runtime/biological_brain.py load_bundle",
        "verification": "latest.json manifestSha256 -> manifest -> per-file sha256 and bytes; schema, scoringVersion and arithmetic validation",
        "lineage": "researchVersion and manifestSha256 in the registry and the artifact lineage",
        "approval": "NOT_RECORDED",
        "onUnavailable": "REFUSE"
      }
    ],
    "researchFallback": false,
    "tests": [
      "brains/fish/tests/test_knowledge_memory.py",
      "brains/fish/tests/test_biological_brain.py"
    ]
  },
  "operations": {
    "executionModes": [
      "INTERNAL"
    ],
    "knowledgeLoading": {
      "approved": "NONE",
      "experimental": "biology-bundle (PRIVATE_BUCKET_RELEASE, gs://sector-biology-private/biology/v1 (latest.json), approval NOT_RECORDED)",
      "refuseWithoutApproved": [
        "CUSTOMER_SERVING"
      ]
    },
    "internalPublication": [
      "fam.activity",
      "fam.brains",
      "fam.health-brains",
      "fam.species",
      "fam.validation"
    ],
    "internalExecution": "in-process in brain-orchestrator (hourly scheduler), runs when its inputs change (VERSION)",
    "customerPublication": {
      "status": "NOT_ELIGIBLE",
      "approvalRef": null
    },
    "notes": "No APPROVED knowledge release exists (approval NOT_RECORDED): production runs are INTERNAL mode on the packaged candidate/reviewed knowledge. Outputs stay in INTERNAL-lane families; customerPublication false (PRE_PRODUCTION)."
  }
}
