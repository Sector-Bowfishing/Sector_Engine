{
  "schemaVersion": "1.0.0",
  "brainId": "lake-brain",
  "displayName": "Lake Brain",
  "humanName": "Lake",
  "domain": "lake-level",
  "lifecycle": "CALIBRATION",
  "contractVersion": "1.0.0",
  "runtime": {
    "kind": "job",
    "language": "swift",
    "entrypoint": "brains/lake/runtime/LakeBrainJob/main.swift",
    "trigger": {
      "kind": "schedule",
      "staleHours": 3
    }
  },
  "publishes": [
    {
      "contractId": "lake-publication-v1",
      "version": "1.0.0",
      "schemaRef": "brains/lake/contracts/lake-publication-v1.json",
      "pathFamilies": [
        "/activity/{event}",
        "/brains/lake-brain/{child}",
        "/health/brains/lake-brain/{child}",
        "/health/sources/{id}",
        "/lakeFleet/{k}/modelVersions/lake",
        "/lakeFleet/{k}/readiness/lake",
        "/lakeFleet/{k}/slots/lake",
        "/lakeFleet/{k}/{child}",
        "/lakes/{k}/brain",
        "/lakes/{k}/speciesPresence",
        "/lakes/{k}/states/lake",
        "/sources/{id}",
        "/validation/lake-brain"
      ],
      "legacyDirectWrites": [
        {"path": "/snapshots/{k}/latest/lakeState", "disposition": "PUBLISHER_COMPATIBILITY_PROJECTION", "ref": "lake-snapshot-copy-v1"},
        {"path": "/snapshots/{k}/latest/brainVersions/lake-brain", "disposition": "PUBLISHER_COMPATIBILITY_PROJECTION", "ref": "lake-snapshot-brainversion-v1"},
        {"path": "/snapshots/{k}/latest/lakeId", "disposition": "PLATFORM_OWNED_STOP_WRITING", "ref": "snapshot-lakeid"},
        {"path": "/health/jobs/{job}", "disposition": "ORCHESTRATOR_DERIVED", "ref": "health-jobs"}
      ]
    }
  ],
  "consumes": [
    {
      "kind": "registry",
      "registry": "lakes",
      "contractId": "registry.lakes",
      "minVersion": "1.0.0",
      "requirement": "REQUIRED"
    }
  ],
  "providers": [
    {"providerId": "iem-hads", "requirement": "OPTIONAL"},
    {"providerId": "nws-nwps", "requirement": "OPTIONAL"},
    {"providerId": "tva-restapi", "requirement": "REQUIRED"},
    {"providerId": "usace-access2water", "requirement": "OPTIONAL"},
    {"providerId": "usace-cwms-pool", "requirement": "REQUIRED"},
    {"providerId": "usbr-rise", "requirement": "OPTIONAL"},
    {"providerId": "usgs-nwis-dv", "requirement": "OPTIONAL"},
    {"providerId": "usgs-nwis-lake-elevation", "requirement": "REQUIRED"}
  ],
  "researchWorkspace": {
    "workspaceId": "lake-brain"
  },
  "score": {
    "type": "ENGINE_READINESS_SCORE",
    "path": "/scores/lake-brain",
    "rubricRef": "docs/brains/scoring/lake-brain-score-v1.json"
  },
  "customerIntegrationMode": "none",
  "publisherRequired": {
    "required": true,
    "cutoverStatus": "SHADOW"
  },
  "authorizedConsumers": [
    "ops",
    "sector-intelligence",
    "depth",
    "vegetation"
  ],
  "tests": [
    "brains/lake/tests"
  ],
  "dataBudget": {
    "maxTrackedFileBytes": 1048576,
    "exceptions": []
  },
  "knowledge": {
    "stores": [
      {
        "id": "reviewed-bindings",
        "store": "COMPILED_IN_BINARY",
        "owner": "lake-brain",
        "location": "brains/lake/runtime/LakeBrain/LakeSourceBindings.swift",
        "loader": "LakeSourceBindings (compiled)",
        "verification": "compiled into the binary; bindingVersion and tableFingerprint",
        "lineage": "bindingVersion in state provenance",
        "approval": "NOT_RECORDED",
        "onUnavailable": "NOT_APPLICABLE"
      },
      {
        "id": "species-presence",
        "store": "PRIVATE_BUCKET_RELEASE",
        "owner": "lake-brain",
        "location": "gs://sector-lake-brain (presence/latest.json)",
        "loader": "LakePresenceIndex.load",
        "verification": "pointer -> release fingerprint, researchVersion and rowCount; vocabulary, assessed-species and directory checks",
        "lineage": "presence fingerprint and sourceRef in the presence records",
        "approval": "NOT_RECORDED",
        "onUnavailable": "DEGRADE_EXPLICITLY"
      }
    ],
    "researchFallback": false,
    "tests": [
      "brains/lake/tests/swift/LakeKnowledgeMemoryTests.swift",
      "brains/lake/tests/swift/LakeBrainTests.swift"
    ],
    "notes": "Level baselines in gs://sector-lake-brain are derived operational state rebuilt from observations, not approved knowledge. A missing presence pointer writes no presence; a refused release records presenceError."
  },
  "operations": {
    "executionModes": [
      "INTERNAL"
    ],
    "knowledgeLoading": {
      "approved": "NONE",
      "experimental": "reviewed-bindings (COMPILED_IN_BINARY, brains/lake/runtime/LakeBrain/LakeSourceBindings.swift, approval NOT_RECORDED); species-presence (PRIVATE_BUCKET_RELEASE, gs://sector-lake-brain (presence/latest.json), approval NOT_RECORDED)",
      "refuseWithoutApproved": [
        "CUSTOMER_SERVING"
      ]
    },
    "internalPublication": [
      "fam.activity",
      "fam.brains",
      "fam.health-brains",
      "fam.health-sources",
      "fam.lake-brain-node",
      "fam.lake-species-presence",
      "fam.lake-states",
      "fam.lakefleet",
      "fam.sources",
      "fam.validation"
    ],
    "internalExecution": "lake-brain Cloud Run job, lake-brain-ledger-daily Cloud Scheduler (validation exception), pilot lakes",
    "execution": {"authority": "brain-orchestrator", "trigger": "TIME", "minIntervalHours": 26.0, "refresh": "daily prospective ledger run (pilots); due when 26 h old", "dependsOn": [], "independentSchedule": false, "controlledBy": "fam.control-execution-control (global + per-Brain; fail closed; read by the orchestrator only)"},
    "customerPublication": {
      "status": "NOT_ELIGIBLE",
      "approvalRef": null
    },
    "notes": "No APPROVED knowledge release exists (approval NOT_RECORDED): production runs are INTERNAL mode on the packaged candidate/reviewed knowledge. Outputs stay in INTERNAL-lane families; customerPublication false (PRE_PRODUCTION)."
  }
}
