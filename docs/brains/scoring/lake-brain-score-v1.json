{
  "scoreVersion": "lake-brain-score-v1",
  "brainId": "lake-brain",
  "scale": 10,
  "scope": "quality dimensions over PROFILED lakes (published /lakes/{k}/brain); coverage and validation fleet-wide",
  "dimensions": [
    {
      "id": "sourceAuthority",
      "label": "Level source is the operator pool or the lake's own gauge",
      "weight": 15,
      "fact": "profiles[*].sourceCapability.level in {DIRECT_OPERATOR_POOL, DIRECT_LAKE_GAUGE}",
      "scale": "share x 10"
    },
    {
      "id": "operatorPlan",
      "label": "Operating guide or zone known",
      "weight": 10,
      "fact": "profiles[*].operatingPools.guideCurve.available or operatingZoneSource",
      "scale": "share x 10"
    },
    {
      "id": "historyQuality",
      "label": ">= 5 complete years of daily history",
      "weight": 15,
      "fact": "profiles[*].historicalCoverage.baselineStatus == SUFFICIENT",
      "scale": "share x 10"
    },
    {
      "id": "seasonalBaseline",
      "label": "A day-of-year baseline exists",
      "weight": 10,
      "fact": "baselineStatus in {SUFFICIENT, LIMITED}",
      "scale": "share x 10"
    },
    {
      "id": "trendQuality",
      "label": "Last state is observed, not a proxy",
      "weight": 10,
      "fact": "states[*].kind == observed",
      "scale": "share x 10"
    },
    {
      "id": "floodDroughtContext",
      "label": "Flood-pool state known",
      "weight": 5,
      "fact": "states[*].floodPoolState != UNKNOWN",
      "scale": "share x 10"
    },
    {
      "id": "validation",
      "label": "Fleet validation",
      "weight": 15,
      "fact": "/validation/lake-brain.status",
      "scale": {
        "NOT_VALIDATED": 0,
        "PARTIAL": 5,
        "VALIDATED": 10
      }
    },
    {
      "id": "coverage",
      "label": "Lakes profiled",
      "weight": 20,
      "fact": "profiled / directoryLakeCount",
      "scale": "coverage ladder"
    }
  ],
  "gates": [
    {
      "id": "coverage",
      "when": "profiled share < 10%",
      "cap": 3.0
    },
    {
      "id": "validation",
      "when": "validation NOT_VALIDATED",
      "cap": 5.0
    },
    {
      "id": "health",
      "when": "brain health FAILED or UNKNOWN",
      "cap": 2.0
    }
  ],
  "movesUp": [
    "reviewed bindings for more lakes",
    "history backfill to >= 5 complete years",
    "a validation run against operator truth"
  ],
  "cannotCount": [
    "the 621-lake directory itself",
    "Ops pages",
    "unreviewed CANDIDATE bindings"
  ]
}
