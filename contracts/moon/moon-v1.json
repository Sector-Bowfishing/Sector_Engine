{
  "algorithm": {
    "illumination": "Low-precision ephemeris (Paul Schlyter, 'How to compute planetary positions'), evaluated at the exact instant (day number d includes the UT fraction; epoch 2000 Jan 0.0 UT). Elongation psi = acos(cos(moonLon - sunLon) * cos(moonLat)); illumination = (1 + cos(180 - psi)) / 2, clamped to 0..1. Moon perturbations include evection and variation.",
    "phaseFraction": "((t - 947182440 s) / 86400 mod 29.530588853 + 29.530588853) mod 29.530588853 / 29.530588853; 0 = new, 0.5 = full. Used for the phase NAME only, never for illumination.",
    "phaseName": "fraction < 0.03 or >= 0.97: New moon; < 0.22 Waxing crescent; < 0.28 First quarter; < 0.47 Waxing gibbous; < 0.53 Full moon; < 0.72 Waning gibbous; < 0.78 Last quarter; else Waning crescent",
    "waxing": "phaseFraction <= 0.5"
  },
