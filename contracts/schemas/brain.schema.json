{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sector.engine/contracts/schemas/brain.schema.json",
  "title": "brain.json (Sector Engine Brain declaration) v1",
  "description": "Machine-authoritative STRUCTURED IDENTITY AND EDGES for one specialist Brain. Not prose, not thresholds, not scientific parameters, never a physical path. Behavior and research rules live in BRAIN_OPERATING_CONTRACT.md. The Brain Registry (platform/registries/brains) is GENERATED from these files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "brainId",
    "displayName",
    "humanName",
    "domain",
    "lifecycle",
    "contractVersion",
    "runtime",
    "publishes",
    "consumes",
    "providers",
    "researchWorkspace",
    "customerIntegrationMode",
    "publisherRequired",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "brainId": {
      "$ref": "#/$defs/brainId",
      "description": "STABLE machine id. Never renamed (e.g. directory brains/fish has brainId biological-state)."
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "humanName": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "enum": [
        "RESEARCH",
        "PROFILED",
        "SHADOW",
        "CALIBRATION",
        "PRODUCTION_READY",
        "PRODUCTION",
        "BLOCKED",
        "DEGRADED",
        "RETIRED"
      ]
    },
    "contractVersion": {
      "$ref": "#/$defs/semver"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "language"
      ],
      "properties": {
        "kind": {
          "enum": [
            "job",
            "in-process",
            "service"
          ]
        },
        "language": {
          "enum": [
            "python",
            "swift",
            "mixed"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path or module; never absolute."
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "schedule",
                "dependency",
                "request",
                "manual"
              ]
            },
            "staleHours": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "publishes": {
      "type": "array",
      "description": "Published contracts/artifacts. An empty list is allowed only with publishesReason.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractId",
          "version",
          "pathFamilies"
        ],
        "properties": {
          "contractId": {
            "$ref": "#/$defs/contractId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          },
          "schemaRef": {
            "$ref": "#/$defs/repoPath"
          },
          "pathFamilies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "publishesReason": {
      "type": "string",
      "minLength": 1
    },
    "consumes": {
      "type": "array",
      "description": "Other Brains' published contracts, or platform registry contracts. Consumed ONLY through a declared contract (never private runtime).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "contractId",
          "minVersion"
        ],
        "properties": {
          "kind": {
            "enum": [
              "brain",
              "registry"
            ]
          },
          "brainId": {
            "$ref": "#/$defs/brainId"
          },
          "registry": {
            "enum": [
              "lakes",
              "species",
              "brains"
            ]
          },
          "contractId": {
            "$ref": "#/$defs/contractId"
          },
          "minVersion": {
            "$ref": "#/$defs/semver"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "brain"
                }
              }
            },
            "then": {
              "required": [
                "brainId"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "registry"
                }
              }
            },
            "then": {
              "required": [
                "registry"
              ]
            }
          }
        ]
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerId"
        ],
        "properties": {
          "providerId": {
            "$ref": "#/$defs/providerId"
          },
          "domainInterpreter": {
            "type": "boolean",
            "description": "true when THIS Brain is the domain interpreter of this provider's data. Providers never interpret."
          }
        }
      }
    },
    "researchWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "LOGICAL id (e.g. wind-brain). Physical root is resolved via SECTOR_RESEARCH_ROOT / config, never encoded here."
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "ENGINE_READINESS_SCORE"
        },
        "path": {
          "type": "string",
          "pattern": "^/scores/[a-z][a-z0-9-]*$"
        },
        "rubricRef": {
          "$ref": "#/$defs/repoPath"
        }
      }
    },
    "customerIntegrationMode": {
      "$ref": "#/$defs/customerIntegrationMode"
    },
    "publisherRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "cutoverStatus"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "cutoverStatus": {
          "enum": [
            "NOT_STARTED",
            "SHADOW",
            "CUTOVER_COMPLETE",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "authorizedConsumers": {
      "type": "array",
      "description": "Who may consume this Brain's published contracts: 'engine', 'ops', or a brainId.",
      "items": {
        "type": "string",
        "pattern": "^(engine|ops|[a-z][a-z0-9]*(-[a-z0-9]+)*)$"
      },
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repoPath"
      },
      "uniqueItems": true
    },
    "dataBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxTrackedFileBytes": {
          "type": "integer",
          "minimum": 1
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        }
      }
    }
  },
  "$defs": {
    "brainId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*([.-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/~][^:\\\\]*$",
      "description": "Repo-relative path: no leading slash, no ~, no drive/backslash."
    },
    "customerIntegrationMode": {
      "enum": [
        "none",
        "embedded",
        "published"
      ],
      "description": "none = no customer path. embedded = customer Engine imports/executes an approved Brain-owned contract/library (NOT: Brain writes customer DB, NOT: Brain calls Engine internals). published = customer product consumes an explicitly approved published Brain output. Direction is always Customer Engine -> approved Brain contract."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publishes": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "required": [
          "publishesReason"
        ]
      }
    }
  ]
}
