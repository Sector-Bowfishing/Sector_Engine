{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sector.engine/contracts/schemas/engineering-status-v1.schema.json",
  "title": "Sector Engine engineering status v1",
  "description": "Machine-readable engineering status for Sector Ops: structural certification, standing memory checks, verification runs and open decisions. Generated by tools/cortex_status/build_engineering_status.py from committed Cortex records only. Branch status is not production status; production columns say what the evidence supports and are NOT_VERIFIED otherwise. v1.1.0 adds (optional, additive) the seven separate status layers per Brain, per-proof certification results, key requirement results, structural problems, science dependencies, recommended next work, recent engineering changes and CI evidence. v1.2.0 adds source.sourceDigest / certificationDigest / certificationCurrent / verificationCommit: a report or certification run of other code can never present as current.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "reportId",
    "standards",
    "source",
    "statusVocabulary",
    "brains",
    "verification",
    "decisions"
  ],
  "properties": {
    "schema": {
      "const": "engineering-status-v1"
    },
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ]
    },
    "reportId": {
      "type": "string",
      "pattern": "^sector-engine-engineering-status-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework",
        "version",
        "pin",
        "pack"
      ],
      "properties": {
        "framework": {
          "const": "Rehtac Cortex"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "pin": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "pack": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "evaluatedCommit",
        "evaluatedAt",
        "session",
        "productionBasis"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "evaluatedCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "evaluatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "session": {
          "type": "string"
        },
        "productionBasis": {
          "type": "string"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "content digest of the evaluated engineering surface (tools/cortex_status/source_digest.py)"
        },
        "certificationDigest": {
          "type": "string",
          "description": "sourceDigest the recorded Kit V1 run was produced at, or NONE"
        },
        "certificationCurrent": {
          "type": "boolean",
          "description": "true only when the certification run belongs to exactly this code"
        },
        "verificationCommit": {
          "type": "string"
        }
      }
    },
    "statusVocabulary": {
      "type": "array",
      "items": {
        "enum": [
          "PASS",
          "FAIL",
          "PARTIAL",
          "NOT_VERIFIED",
          "NOT_APPLICABLE",
          "BLOCKED"
        ]
      }
    },
    "brains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "brainId",
          "directory",
          "lifecycle",
          "packageStatus",
          "structuralCertification",
          "memory",
          "memorySummary",
          "blockers"
        ],
        "properties": {
          "brainId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "description": "Canonical package directory, or branch:<branch>:<path> for a Brain with no package on main"
          },
          "lifecycle": {
            "type": "string"
          },
          "packageStatus": {
            "enum": [
              "CANONICAL",
              "BRANCH_ONLY"
            ]
          },
          "structuralCertification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "evidence"
            ],
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "PARTIAL",
                  "NOT_VERIFIED",
                  "NOT_APPLICABLE",
                  "BLOCKED"
                ]
              },
              "evidence": {
                "type": "string"
              }
            }
          },
          "memory": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "check",
                "branch",
                "production",
                "evidence"
              ],
              "properties": {
                "check": {
                  "type": "string"
                },
                "branch": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "PARTIAL",
                    "NOT_VERIFIED",
                    "NOT_APPLICABLE",
                    "BLOCKED"
                  ]
                },
                "production": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "PARTIAL",
                    "NOT_VERIFIED",
                    "NOT_APPLICABLE",
                    "BLOCKED"
                  ]
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          "memorySummary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "branch",
              "production"
            ],
            "properties": {
              "branch": {
                "type": "object"
              },
              "production": {
                "type": "object"
              }
            }
          },
          "recovery": {
            "type": "string"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "statusLayers": {
            "type": "object",
            "additionalProperties": false,
            "description": "Never collapsed into one flag: structure, certification, science, approved memory, operational readiness, production and customer are separate.",
            "required": [
              "canonicalStructure",
              "structuralCertification",
              "scientificValidation",
              "approvedMemoryRelease",
              "operationalReadiness",
              "productionActivation",
              "customerConsumable"
            ],
            "properties": {
              "canonicalStructure": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "label",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "PARTIAL",
                      "NOT_VERIFIED",
                      "NOT_APPLICABLE",
                      "BLOCKED"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              },
              "structuralCertification": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "label",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "PARTIAL",
                      "NOT_VERIFIED",
                      "NOT_APPLICABLE",
                      "BLOCKED"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              },
              "scientificValidation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "label",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "PARTIAL",
                      "NOT_VERIFIED",
                      "NOT_APPLICABLE",
                      "BLOCKED"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              },
              "approvedMemoryRelease": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "label",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "PARTIAL",
                      "NOT_VERIFIED",
                      "NOT_APPLICABLE",
                      "BLOCKED"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              },
              "operationalReadiness": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "label",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "PARTIAL",
                      "NOT_VERIFIED",
                      "NOT_APPLICABLE",
                      "BLOCKED"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              },
              "productionActivation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "label",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "PARTIAL",
                      "NOT_VERIFIED",
                      "NOT_APPLICABLE",
                      "BLOCKED"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              },
              "customerConsumable": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "label",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "PARTIAL",
                      "NOT_VERIFIED",
                      "NOT_APPLICABLE",
                      "BLOCKED"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "certificationProofs": {
            "type": "object",
            "description": "Kit V1 proof id -> actual outcome from the recorded run (inputs/certification.json)"
          },
          "certificationMutations": {
            "type": "object"
          },
          "requirements": {
            "type": "object",
            "description": "Cortex requirement id -> status (from the compliance ledger)"
          },
          "structuralProblems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scienceDependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nextWork": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dataDependencies": {
            "type": "object",
            "description": "Operational data the Brain actually needs, from brain.json (verified by Kit P06 and the dependency graph): declared inputs, live providers, approved knowledge stores. Research data is never a runtime fallback."
          },
          "operations": {
            "$ref": "#/$defs/operations",
            "description": "Cortex 2.6.0 four independent dimensions (IO-01). Static: scientific validation, knowledge, customer eligibility, scores, limitations. Live (published document only): runtime readiness and internal operation."
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suite",
          "result"
        ],
        "properties": {
          "suite": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "passed": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "title",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "class": {
            "enum": [
              "APPROVAL",
              "DECISION_REQUIRED",
              "GATED"
            ]
          },
          "title": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "brains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "cortexGaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "summary"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pullRequest",
        "testedCommit",
        "result",
        "checks"
      ],
      "properties": {
        "pullRequest": {
          "type": "string"
        },
        "testedCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "PENDING",
            "NOT_RUN"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "result"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "PENDING",
                  "SKIPPED",
                  "NOT_RUN"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "engineScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement",
        "source"
      ],
      "properties": {
        "measurement": {
          "const": "ENGINEERING_SCORE"
        },
        "source": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "rubric": {
          "type": "string"
        },
        "displayedAs": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "legacyLayers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationalReadiness"
      ],
      "properties": {
        "operationalReadiness": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientificValidation",
        "knowledgeRelease",
        "customerEligibility"
      ],
      "properties": {
        "scientificValidation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "label"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_STARTED",
                "IN_PROGRESS",
                "PARTIAL",
                "VALIDATED",
                "NOT_VERIFIED"
              ]
            },
            "label": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            }
          }
        },
        "knowledgeRelease": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "NONE",
                "RESEARCH",
                "CANDIDATE",
                "APPROVED"
              ]
            },
            "releaseId": {
              "type": "string"
            },
            "approval": {
              "type": "string"
            }
          }
        },
        "customerEligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_ELIGIBLE",
                "ELIGIBLE",
                "NOT_VERIFIED"
              ]
            },
            "basis": {
              "type": "string"
            },
            "approvalRef": {
              "type": "string"
            }
          }
        },
        "executionModes": {
          "type": "array",
          "items": {
            "enum": [
              "INTERNAL",
              "APPROVED_SCIENCE",
              "CUSTOMER_SERVING"
            ]
          }
        },
        "scores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "measurement",
              "source"
            ],
            "properties": {
              "measurement": {
                "enum": [
                  "STRUCTURAL_CERTIFICATION",
                  "RUNTIME_READINESS",
                  "INTERNAL_OPERATIONAL_HEALTH",
                  "SCIENTIFIC_MATURITY",
                  "DOMAIN_CAPABILITY",
                  "CUSTOMER_ELIGIBILITY",
                  "ENGINEERING_SCORE"
                ]
              },
              "source": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "displayedAs": {
                "type": "string"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtimeReadiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "READY",
                "NOT_READY",
                "NOT_VERIFIED"
              ]
            },
            "basis": {
              "type": "string"
            }
          }
        },
        "internalOperation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_DEPLOYED",
                "SHADOW",
                "ACTIVE",
                "DEGRADED",
                "PAUSED",
                "FAILED",
                "NOT_VERIFIED"
              ]
            },
            "basis": {
              "type": "string"
            },
            "trigger": {
              "enum": [
                "TIME",
                "EVENT",
                "SHADOW"
              ]
            },
            "scheduler": {
              "type": "string"
            },
            "schedulerState": {
              "type": "string"
            },
            "expectedIntervalHours": {
              "type": "number"
            },
            "lastExecutionAt": {
              "type": "string"
            },
            "lastExecutionResult": {
              "type": "string"
            },
            "lastSuccessfulRun": {
              "type": "string"
            },
            "lastSuccessfulRunBasis": {
              "type": "string"
            },
            "planCheck": {
              "enum": [
                "OBSERVED",
                "FAILED",
                "NOT_OBSERVED"
              ]
            },
            "lastPlanCheckAt": {
              "type": "string"
            },
            "lane": {
              "type": "string"
            },
            "lastFullRunAt": {
              "type": "string"
            },
            "lastFullRunResult": {
              "type": "string"
            },
            "lastExecutionKind": {
              "enum": [
                "RUN",
                "PLAN_CHECK",
                "SHADOW_RUN"
              ]
            },
            "executionControl": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "global",
                "brainEnabled"
              ],
              "properties": {
                "global": {
                  "enum": [
                    "PAUSED",
                    "ENABLED"
                  ]
                },
                "brainEnabled": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "health": {
          "type": "string"
        },
        "inputFreshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict"
          ],
          "properties": {
            "verdict": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "lastDataUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "string"
            },
            "basis": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "shadowLane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lane",
            "experimental",
            "authoritative",
            "customerEligible"
          ],
          "properties": {
            "lane": {
              "const": "INTERNAL_EXPERIMENTAL"
            },
            "executionMode": {
              "const": "INTERNAL"
            },
            "experimental": {
              "const": true
            },
            "authoritative": {
              "const": false
            },
            "customerEligible": {
              "const": false
            },
            "lastRunAt": {
              "type": "string"
            },
            "lakeCount": {
              "type": "integer"
            },
            "readinessCounts": {
              "type": "object"
            },
            "outputKinds": {
              "type": "object"
            },
            "observedLakes": {
              "type": "integer"
            },
            "candidateReleaseId": {
              "type": "string"
            },
            "candidateApproval": {
              "type": "string"
            },
            "approvedPath": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "status": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            },
            "lastFailureAt": {
              "type": "string"
            }
          }
        },
        "liveAsOf": {
          "type": "string"
        }
      }
    }
  }
}
